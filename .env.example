# ==============================================================================
# Parley App - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO '.env' AND FILL IN YOUR CREDENTIALS BEFORE RUNNING:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL!
# ==============================================================================

# Application Metadata & Environment
APP_NAME=Parley
APP_ENV=development # development | staging | production

# Speech Recognition & Synthesis Timings
SPEECH_LISTEN_TIMEOUT_SECONDS=20
SPEECH_PAUSE_SECONDS=2

# Default Locales
DEFAULT_SOURCE_LOCALE=pt_BR
DEFAULT_TARGET_LOCALE=en_US

# Optional Translation API Services (e.g. Google Cloud Translate API Key)
# Leave blank if utilizing the default community translator engine
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
