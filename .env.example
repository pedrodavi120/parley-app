# ==============================================================================
# Parley App - Modelo de Configuração de Variáveis de Ambiente
# ==============================================================================
# COPIE ESTE ARQUIVO PARA '.env' E PREENCHA SUAS CREDENCIAIS ANTES DE EXECUTAR:
#   cp .env.example .env
#   (No Windows PowerShell: Copy-Item .env.example .env)
#
# NUNCA ENVIE O ARQUIVO '.env' REAL PARA O CONTROLE DE VERSÃO!
# ==============================================================================

# Metadados e Ambiente da Aplicação
APP_NAME=Parley
APP_ENV=development # development | staging | production

# Parâmetros de Reconhecimento e Síntese de Voz (em segundos)
SPEECH_LISTEN_TIMEOUT_SECONDS=20
SPEECH_PAUSE_SECONDS=2

# Localidades Padrão
DEFAULT_SOURCE_LOCALE=pt_BR
DEFAULT_TARGET_LOCALE=en_US

# Serviços Opcionais de API de Tradução (ex: Google Cloud Translate API Key)
# Deixe em branco para utilizar o motor padrão da comunidade
TRANSLATION_API_KEY=
TRANSLATION_API_URL=
